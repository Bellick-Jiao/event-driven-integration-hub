<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="hub-arch" name="Event-Driven Integration Hub">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Event-Driven Integration Hub — high-level architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- API clients -->
        <mxCell id="clients" value="API Clients&#10;(Banker Portal / Callers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- integration-api -->
        <mxCell id="api" value="integration-api  :8080&#10;REST · Idempotency (Idempotency-Key)&#10;Transactional Outbox (write side)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Postgres outbox -->
        <mxCell id="pg-outbox" value="Postgres — hub DB&#10;customer · outbox&#10;idempotency_keys" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Kafka -->
        <mxCell id="kafka" value="Apache Kafka (KRaft)&#10;topic: customer.profile.events&#10;compacted · keyed by customerId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="470" y="220" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- profile-service -->
        <mxCell id="profile" value="profile-service  :8081&#10;group: profile-service-group&#10;idempotent · retry → DLQ → replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- data-loader -->
        <mxCell id="loader" value="data-loader  :8082&#10;group: data-loader-group&#10;fan-out · idempotent wide-table load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="320" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- Postgres profile -->
        <mxCell id="pg-profile" value="Postgres&#10;schema: profile_service&#10;profile_store · processed_events&#10;dlq_events" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="855" y="450" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Postgres warehouse -->
        <mxCell id="pg-loader" value="Postgres&#10;schema: data_loader&#10;data_warehouse · processed_events" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="855" y="560" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Outbox relay annotation -->
        <mxCell id="relay" value="OutboxRelay  (@Scheduled)&#10;PENDING → publish → PUBLISHED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="350" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Cross-cutting infra -->
        <mxCell id="keycloak" value="Keycloak (OIDC / JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="prom" value="Prometheus (metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="zipkin" value="Zipkin (distributed tracing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="560" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-clients-api" value="POST /api/v1/customers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="clients" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-api-pg" value="customer + outbox (same transaction)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="api" target="pg-outbox">
          <mxGeometry relative="1" as="geometry" />
