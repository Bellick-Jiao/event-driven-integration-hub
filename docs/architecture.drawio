        <mxCell id="e-api-kafka" value="relay: transactional producer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="api" target="kafka">
          <mxGeometry relative="1" as="geometry" />
