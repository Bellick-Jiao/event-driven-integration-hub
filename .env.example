# ============ 复制为 .env 后按需修改（.env 不入库）============

# --- PostgreSQL ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub-dev-change-me
POSTGRES_DB=hub

# --- integration-api ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/hub
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_CUSTOMER_EVENTS=customer.profile.events
TOPIC_CUSTOMER_EVENTS_DLQ=customer.profile.events.dlq

# --- OIDC（docker compose --profile security 启用 Keycloak 后生效）---
OIDC_ISSUER_URI=http://localhost:8088/realms/hub
OIDC_JWKS_URI=http://localhost:8088/realms/hub/protocol/openid-connect/certs

# --- Observability（--profile observability 启用后生效）---
ZIPKIN_BASE_URL=http://localhost:9411
