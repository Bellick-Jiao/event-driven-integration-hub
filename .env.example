# ============ copy to .env and adjust as needed (.env is git-ignored) ============

# --- PostgreSQL ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub-dev-change-me
POSTGRES_DB=hub

# --- integration-api ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/hub
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOPIC_CUSTOMER_EVENTS=customer.profile.events
TOPIC_CUSTOMER_EVENTS_DLQ=customer.profile.events.dlq

# --- Keycloak / OIDC (docker compose --profile security) ---
# Must match the issuer of the JWTs Keycloak signs: http://localhost:8088/realms/hub
KEYCLOAK_ISSUER_URI=http://localhost:8088/realms/hub

# --- Observability (docker compose --profile observability) ---
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
